DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_ENGINE as sqlite for local development. Set to mysql and fill in the
# DB_* values to use MySQL.
DB_ENGINE=sqlite
DB_NAME=skillboost
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional. AI quiz generation and course recommendations need this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
